# Copy to .env and fill in. Never commit the real .env.

DATABASE_URL=postgresql+psycopg://mctb:mctb@localhost:5432/mctb
REDIS_URL=redis://localhost:6379/0

# --- Twilio -----------------------------------------------------------
# LOCAL DEV: use TEST credentials (Twilio Console → Account → API keys &
# tokens → "Test credentials"), not the live Account SID/Auth Token.
# Test credentials never send a real SMS and never incur cost, so they're
# safe for the agent (or you) to exercise the full webhook -> SMS flow with.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=changeme                 # also used to validate webhook signatures (spec.md 7.1)
TWILIO_REGION=ie1                          # EU region (GDPR) — production only;
                                            # test credentials ignore region routing

# for signature validation during local dev — set to your ngrok HTTPS URL
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# --- AI (Phase 1) -------------------------------------------------------
AI_SERVICE_URL=http://localhost:8080
AI_TIMEOUT_SECONDS=8

# --- Observability -------------------------------------------------------
SENTRY_DSN=
